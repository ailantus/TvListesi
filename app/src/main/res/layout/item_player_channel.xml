<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="3dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/yuzey"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/vurgu_kap"
    app:strokeColor="@color/kanal_cizgi"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/logo_arka"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv"
            app:tint="@color/soluk" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Kanal adı" />

            <TextView
                android:id="@+id/channelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/soluk"
                android:textSize="11sp"
                tools:text="Ulusal" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
